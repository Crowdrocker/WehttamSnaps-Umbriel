// WehttamSnaps Niri Configuration
// Author: Matthew (Crowdrocker)
// Hardware: AM5 Build - Ryzen 5 9600X, XFX RX 7600 8GB, 16GB DDR5 RAM, 850W PSU
// Display: DP-2 1920x1080@60Hz
// ─────────────────────────────────────────────────────────────────────────────
// 70 — Key bindings (Active Production Suite)
// ─────────────────────────────────────────────────────────────────────────────

binds {

    // ═══════════════════════════════════════════════════════════════════════
    // Session & compositor
    // ═══════════════════════════════════════════════════════════════════════
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Shift+E          { quit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+O          { power-off-monitors; }
    Mod+Shift+Q          { spawn "inir" "session" "toggle"; }
    Mod+Shift+R hotkey-overlay-title="Reload Niri Config" { spawn "niri" "msg" "action" "load-config-file"; }
    // ═══════════════════════════════════════════════════════════════════════
    // iNiR shell overlays & tools
    // ═══════════════════════════════════════════════════════════════════════
    Super+G              { spawn "inir" "overlay" "toggle"; }
    Mod+Space repeat=false { spawn "inir" "overview" "toggle"; }
    Mod+V                { spawn "inir" "clipboard" "toggle"; }
    Mod+Ctrl+Shift+L allow-when-locked=true { spawn "inir" "lock" "focus"; }
    Mod+Shift+X          { spawn "inir" "region" "ocr"; }
    Mod+Shift+A          { spawn "inir" "region" "search"; }
    Ctrl+Shift+S         { spawn "inir" "region" "menu"; }
    Ctrl+Alt+T           { spawn "inir" "wallpaperSelector" "toggle"; }
    Mod+Comma            { spawn "inir" "settings"; }
    Mod+Slash            { spawn "inir" "cheatsheet" "toggle"; }
    Mod+Shift+W          { spawn "inir" "panelFamily" "cycle"; }
    Ctrl+Alt+F           { spawn "inir" "equalizer" "toggle"; }

    // ═══════════════════════════════════════════════════════════════════════
    // Streamer Multi-Monitor Focus (Left Hand Only)
    // ═══════════════════════════════════════════════════════════════════════
    Mod+Alt+H hotkey-overlay-title="Focus Gaming Monitor (Left)"   { focus-monitor-left; }
    Mod+Alt+L hotkey-overlay-title="Focus Stream Monitor (Right)"  { focus-monitor-right; }
    Mod+Alt+Shift+L hotkey-overlay-title="Move Window to Right Monitor" { move-column-to-monitor-right; }
    Mod+Alt+Shift+H hotkey-overlay-title="Move Window to Left Monitor"  { move-column-to-monitor-left; }

        // ═══════════════════════════════════════════════════════════════════════
    // MangoHUD On-The-Fly Diagnostic Controls
    // ═══════════════════════════════════════════════════════════════════════

    // Toggle the performance overlay completely ON or OFF mid-game
    Mod+Alt+M hotkey-overlay-title="Toggle MangoHUD Overlay" {
        spawn "sh" "-c" "pkill -USR1 mangohud || xdotool key Shift_R+F12";
    }

    // Cycle through different display modes (Compact FPS -> Full Specs -> Minimal)
    Mod+Alt+F12 hotkey-overlay-title="Cycle MangoHUD Layout Style" {
        spawn "sh" "-c" "pkill -USR2 mangohud";
    }


    // ═══════════════════════════════════════
    // J.A.R.V.I.S. VISUAL MENU SYSTEM
    // ═══════════════════════════════════════
    Mod+Alt+Space  hotkey-overlay-title="jarvis-menu-main"       { spawn "jarvis-menu" "main"; }
    Mod+Alt+A      hotkey-overlay-title="jarvis-menu-apps"       { spawn "jarvis-menu" "apps"; }
    Mod+W          hotkey-overlay-title="jarvis-menu-workspaces" { spawn "jarvis-menu" "workspaces"; }
    Mod+Alt+Slash  hotkey-overlay-title="jarvis-menu-command"    { spawn "jarvis-menu" "command"; }
    Mod+Alt+J      hotkey-overlay-title="jarvis-menu-interactive"{ spawn "konsole" "-e" "jarvis" "interactive"; }

    // ── SNAPS-OS custom scripts ──
    Mod+M          hotkey-overlay-title="Mango config editor"    { spawn "sh" "-c" "ghostty -e ~/.config/snapsos/niri-config.sh"; }
    //Mod+Alt+M      hotkey-overlay-title="Mango config explainer" { spawn "sh" "-c" "ghostty -e ~/.config/snapsos/config-overview/menu.sh"; }
    Mod+0          hotkey-overlay-title="SNAPS-OS tip"           { spawn "sh" "-c" "notify-send \"SNAPS-OS Tips\" \"$(shuf -n 1 ~/.config/snapsos/tips/tips.list | sed 's/.*: //')\""; }
    Mod+Y          hotkey-overlay-title="Shelly"                 { spawn "shelly-ui"; }
    Mod+Shift+Y    hotkey-overlay-title="unipkg TUI"             { spawn "sh" "-c" "ghostty -e unipkg launch-tui"; }
    Mod+Ctrl+G     hotkey-overlay-title="Glyph dictionary"       { spawn "/usr/bin/glyphs" "--dictionary"; }
    Mod+Alt+W      hotkey-overlay-title="Close glyphs"           { spawn "sh" "-c" "pkill -f \"[p]ython3 /usr/bin/glyphs\""; }
    Mod+Shift+Tab  hotkey-overlay-title="Project select"         { spawn "sh" "-c" "ghostty -e ~/.config/snapsos/tuis/project-select.sh"; }

    // ── Core applications (with J.A.R.V.I.S. sounds) ──
    Mod+Shift+Return hotkey-overlay-title="Kitty"                { spawn "kitty"; }
    Mod+Alt+B      hotkey-overlay-title="Firefox"                { spawn "sh" "-c" "/usr/bin/sound-system launch-firefox && firefox"; }
    Mod+E          hotkey-overlay-title="Open File Manager (Yazi)" { spawn "yazi" "-e" "y"; }
    Mod+Shift+T    hotkey-overlay-title="Open Kate"              { spawn "kate"; }
    Mod+O          hotkey-overlay-title="Open OBS"               { spawn "flatpak" "run" "--env=QT_QPA_PLATFORM=xcb" "com.obsproject.Studio"; }
    Mod+P          hotkey-overlay-title="Open spotify-launcher"  { spawn "spotify-launcher"; }

    // ── WEBAPPS (Mod+Ctrl Launcher Routing) ──
    Mod+Ctrl+T     hotkey-overlay-title="twitch"                 { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh twitch"; }
    Mod+Ctrl+Y     hotkey-overlay-title="youtube"                { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh youtube"; }
    Mod+Ctrl+S     hotkey-overlay-title="spotify"                { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh spotify"; }
    Mod+Ctrl+D     hotkey-overlay-title="discord"                { spawn "sh" "-c" "~/.config/niri/scripts/webapp-launcher.sh discord"; }

    // ── WehttamSnaps specific ──
    Mod+Shift+G    hotkey-overlay-title="Gamemode"               { spawn "gamemode"; }
    Mod+Shift+S                                                  { spawn "sh" "-c" "/usr/bin/sound-system steam-launch && steam"; }
    Mod+Alt+G                                                    { spawn "/usr/bin/game-launcher"; }

    // ── Screenshots (SNAPS-OS wayshell scripts) ──
    Mod+Ctrl+F10   hotkey-overlay-title="Screenshot window"      { spawn "sh" "-c" "~/.config/snapsos/wayshell/configs/ss-capture.sh active"; }
    Mod+Shift+F10  hotkey-overlay-title="Screenshot monitor"     { spawn "sh" "-c" "~/.config/snapsos/wayshell/configs/ss-capture.sh output"; }
    Mod+Ctrl+Shift+F10 hotkey-overlay-title="Screenshot all monitors" { spawn "sh" "-c" "~/.config/snapsos/wayshell/configs/ss-capture.sh screen"; }

        // ─── Screenshots ───
    CTRL+Shift+1 hotkey-overlay-title="Screenshot"        { screenshot; }
    CTRL+Shift+2 hotkey-overlay-title="screenshot-screen" { screenshot-screen; }
    CTRL+Shift+3 hotkey-overlay-title="screenshot-window" { screenshot-window; }
    // ═══════════════════════════════════════════════════════════════════════
    // Window management & Focus navigation (arrows + Vim keys)
    // FIXED: Embedded semicolons between adjacent inline bindings
    // ═══════════════════════════════════════════════════════════════════════
    Mod+Left { focus-column-left; };   Mod+Right { focus-column-right; }
    Mod+Up   { focus-window-up; };     Mod+Down  { focus-window-down; }
    Mod+H    { focus-column-left; };   Mod+L     { focus-column-right; }
    Mod+K    { focus-window-up; };     Mod+J     { focus-window-down; }

    Mod+Shift+Left { move-column-left; };  Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up   { move-window-up; };    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H    { move-column-left; };  Mod+Shift+L     { move-column-right; }
    Mod+Shift+K    { move-window-up; };    Mod+Shift+J     { move-window-down; }

    Mod+Home { focus-column-first; };  Mod+End         { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }; Mod+Ctrl+End { move-column-to-last; }

    Mod+Ctrl+Left  { focus-monitor-left; };  Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Up    { focus-monitor-up; };    Mod+Ctrl+Down  { focus-monitor-down; }

    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; };
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; };
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }

    Mod+1 { focus-workspace 1; };  Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+2 { focus-workspace 2; };  Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+3 { focus-workspace 3; };  Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+4 { focus-workspace 4; };  Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+5 { focus-workspace 5; };  Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+6 { focus-workspace 6; };  Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+7 { focus-workspace 7; };  Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+8 { focus-workspace 8; };  Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+9 { focus-workspace 9; };  Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Page_Down { focus-workspace-down; };          Mod+Page_Up   { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }; Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }; Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }; Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; };  Mod+WheelScrollLeft { focus-column-left; }

    F10 { screenshot; }; Ctrl+F10 { screenshot-screen; }; Alt+F10 { screenshot-window; }

        // 🔊 Hardware Volume Scroll Wheel & Media Controls
    // Direct hardware-level PipeWire volume control fallback
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "inir" "audio" "micMute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "inir" "brightness" "increment"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "inir" "brightness" "decrement"; }
    XF86AudioPlay  { spawn "inir" "mpris" "playPause"; }
    XF86AudioPause { spawn "inir" "mpris" "playPause"; }
    XF86AudioNext  { spawn "inir" "mpris" "next"; }
    XF86AudioPrev  { spawn "inir" "mpris" "previous"; }

    Ctrl+Mod+Space { spawn "inir" "mpris" "playPause"; }; Mod+Alt+N      { spawn "inir" "mpris" "next"; }
    Mod+Alt+P      { spawn "inir" "mpris" "previous"; };  Mod+Shift+M    { spawn "inir" "audio" "mute"; }
    Mod+Shift+P    { spawn "inir" "mpris" "playPause"; }; Mod+Shift+N    { spawn "inir" "mpris" "next"; }
    Mod+Shift+B    { spawn "inir" "mpris" "previous"; }

    // FIXED: Swapped out broken external script hook for Niri's native close engine
    Mod+Q repeat=false { close-window; }
    Mod+D { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+A { toggle-window-floating; }
    Mod+R { switch-preset-column-width; }
    Mod+C { center-column; }
    }

    recent-windows {
    binds {
    Alt+Tab { next-window; }
    Alt+Shift+Tab { previous-window; }
    }
}
