#!/bin/bash
# ╔══════════════════════════════════════════════════════════════════╗
# ║  sound-system — WehttamSnaps Adaptive Sound System (Umbriel)     ║
# ║  Switches between J.A.R.V.I.S. and iDroid based on context       ║
# ║  github.com/Crowdrocker  |  twitch.tv/WehttamSnaps               ║
# ╚══════════════════════════════════════════════════════════════════╝
set -euo pipefail

# ════════════════════════════════════════════════════════════════════
#  📋 CONFIGURATION
# ════════════════════════════════════════════════════════════════════
SILENT_FLAG="$HOME/.cache/wehttamsnaps/silent.active"
SOUND_BASE="/usr/share/wehttamsnaps/sounds"
STATE_FILE="$HOME/.cache/wehttamsnaps/sound-mode.state"
WORKSPACE_FILE="$HOME/.cache/wehttamsnaps/current-workspace.state"
GAMING_FLAG="$HOME/.cache/wehttamsnaps/gaming-mode.active"

mkdir -p "$(dirname "$STATE_FILE")"
mkdir -p "$SOUND_BASE"/{jarvis,idroid}

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ════════════════════════════════════════════════════════════════════
#  🎯 WORKSPACE MAP (Umbriel Named & Numbered Workspaces)
# ════════════════════════════════════════════════════════════════════
get_current_mode() {
    [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "jarvis"
}

set_mode() {
    local mode="$1"
    echo "$mode" > "$STATE_FILE"
    echo -e "${CYAN}🔊 Sound mode:${NC} ${GREEN}$mode${NC}"
}

get_current_workspace() {
    if command -v umbriel &>/dev/null; then
        # Extract active/focused workspace name from `umbriel workspaces`
        umbriel workspaces 2>/dev/null | awk '/\*|focused/ {print $NF; exit}' | tr -d '():*' || echo "Browser"
    elif [[ -f "$WORKSPACE_FILE" ]]; then
        cat "$WORKSPACE_FILE"
    else
        echo "Browser"
    fi
}

# ════════════════════════════════════════════════════════════════════
#  🤖 AUTO-DETECT MODE
# ════════════════════════════════════════════════════════════════════
auto_detect_mode() {
    local workspace
    workspace=$(get_current_workspace)

    # Gaming flag overrides everything
    [[ -f "$GAMING_FLAG" ]] && echo "idroid" && return

    case "${workspace,,}" in
        gaming|stream|3|6) echo "idroid" ;; # Gaming & Stream -> iDroid
        *)                 echo "jarvis" ;; # Everything else -> J.A.R.V.I.S.
    esac
}

# ════════════════════════════════════════════════════════════════════
#  🔊 PLAY SOUND (WITH MULTI-TAKE RANDOMIZATION)
# ════════════════════════════════════════════════════════════════════
find_random_take() {
    local dir="$1"
    local base="$2"
    # Matches base.mp3, base-2.mp3, base_v2.mp3, etc. in top-level folder
    find "$dir" -maxdepth 1 -type f \( -name "${base}.mp3" -o -name "${base}-*.mp3" -o -name "${base}_*.mp3" \) 2>/dev/null | shuf -n 1
}

play_sound() {
    local sound_name="$1"
    local force_mode="${2:-}"
    local sync_mode="${3:-async}" # Pass "sync" when chaining two clips

    [[ -f "$SILENT_FLAG" ]] && return 0

    local mode
    if [[ -n "$force_mode" ]]; then
        mode="$force_mode"
    else
        mode=$(auto_detect_mode)
    fi

    local alt_mode
    [[ "$mode" == "jarvis" ]] && alt_mode="idroid" || alt_mode="jarvis"

    # Strip optional mode prefix so both "reloading-config" and "jarvis-reload" resolve
    local clean_name="${sound_name#${mode}-}"
    clean_name="${clean_name#${alt_mode}-}"

    local sound_path=""
    for candidate_dir in "$SOUND_BASE/$mode" "$SOUND_BASE/$alt_mode"; do
        for candidate_name in "$sound_name" "$clean_name" "${mode}-${clean_name}" "${alt_mode}-${clean_name}"; do
            sound_path=$(find_random_take "$candidate_dir" "$candidate_name")
            [[ -n "$sound_path" ]] && break 2
        done
    done

    if [[ -n "$sound_path" && -f "$sound_path" ]]; then
        if [[ "$sync_mode" == "sync" ]]; then
            pw-play "$sound_path" &>/dev/null || paplay "$sound_path" &>/dev/null
        else
            (pw-play "$sound_path" || paplay "$sound_path") &>/dev/null &
        fi
    else
        echo -e "${YELLOW}⚠${NC}  Sound not found: $sound_name.mp3 (tried $mode + $alt_mode)"
    fi
}

# ════════════════════════════════════════════════════════════════════
#  🎵 AUDIO CONTROLS
# ════════════════════════════════════════════════════════════════════
audio_mute_toggle() {
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    if wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q "MUTED"; then
        play_sound "audio-mute"
    else
        play_sound "audio-unmute"
    fi
}

audio_volume_up() {
    wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
    play_sound "volume-up"
}

audio_volume_down() {
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    play_sound "volume-down"
}

mic_mute_toggle() {
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q "MUTED"; then
        play_sound "audio-mute"
    else
        play_sound "audio-unmute"
    fi
}

# ════════════════════════════════════════════════════════════════════
#  🎮 GAMING MODE
# ════════════════════════════════════════════════════════════════════
gamemode_on() {
    touch "$GAMING_FLAG"
    set_mode "idroid"
    play_sound "gamemode-on" "idroid"
    notify-send "iDroid" "Combat systems online. Gaming mode activated." \
        -i applications-games -t 3000
}

gamemode_off() {
    rm -f "$GAMING_FLAG"
    set_mode "jarvis"
    play_sound "gamemode-off" "idroid"
    notify-send "J.A.R.V.I.S." "Normal operation restored. Welcome back, Matthew." \
        -i audio-speakers -t 3000
}

# ════════════════════════════════════════════════════════════════════
#  💻 SYSTEM, WINDOW & WORKSPACE EVENTS
# ════════════════════════════════════════════════════════════════════
system_startup() {
    set_mode "jarvis"
    local hour
    hour=$(date +%H)
    local tod="evening"
    if (( 10#$hour >= 5 && 10#$hour < 12 )); then
        tod="morning"
    elif (( 10#$hour >= 12 && 10#$hour < 17 )); then
        tod="afternoon"
    fi
    (
        play_sound "jarvis-startup" "jarvis" "sync"
        play_sound "$tod" "jarvis" "sync"
    ) &
}

system_shutdown()      { play_sound "jarvis-shutdown" "jarvis"; }
notification()         { play_sound "jarvis-notification"; }
screenshot_taken()     { play_sound "jarvis-screen-capture" "jarvis"; }
config_reload()        { play_sound "reloading-config" "jarvis"; }
locking_screen()       { play_sound "locking-screen" "jarvis"; }
steam_launch()         { set_mode "idroid"; play_sound "steam-launch" "idroid"; }
photo_export()         { play_sound "photo-export" "jarvis"; }
photo_mode()           { set_mode "jarvis"; play_sound "photo-mode" "jarvis"; }
gaming_mode_voice()    { set_mode "idroid"; play_sound "jarvis-gaming" "jarvis"; }
streaming_on()         { set_mode "idroid"; play_sound "jarvis-streaming" "jarvis"; }
greeting()             { play_sound "greeting"; }
confirm()              { play_sound "jarvis-confirm"; }

# Window Events
window_close()         { play_sound "closing-window"; }
window_float()         { play_sound "window-float"; }
window_fullscreen()    { play_sound "window-fullscreen"; }
window_tile()          { play_sound "window-tile"; }
window_center()        { play_sound "window-center"; }

# Workspace Events
workspace_switch() {
    local workspace="${1:-Browser}"
    echo "$workspace" > "$WORKSPACE_FILE"
    local new_mode
    new_mode=$(auto_detect_mode)
    set_mode "$new_mode"
    play_sound "workspace-switch"
}
workspace_next()       { play_sound "workspace-next"; }
workspace_previous()   { play_sound "workspace-previous"; }

# ════════════════════════════════════════════════════════════════════
#  🚀 APPLICATION LAUNCHERS & MEDIA
# ════════════════════════════════════════════════════════════════════
launch_browser()       { play_sound "accessing-web"; }
launch_firefox()       { play_sound "launching-firefox"; }
launch_discord()       { play_sound "launching-discord"; }
launch_editor()        { play_sound "launching-editor"; }
launch_gimp()          { play_sound "launching-gimp"; }
launch_obs()           { play_sound "launching-obs"; }
launch_spotify()       { play_sound "launching-spotify"; }
open_terminal()        { play_sound "opening-terminal"; }
open_files()           { play_sound "opening-files"; }

music_play()           { play_sound "music-play"; }
music_pause()          { play_sound "music-pause"; }
music_next()           { play_sound "music-next"; }
music_previous()       { play_sound "music-previous"; }

# ════════════════════════════════════════════════════════════════════
#  🧪 TESTING & DIAGNOSTICS
# ════════════════════════════════════════════════════════════════════
list_sounds() {
    echo -e "${CYAN}📁 Available sounds:${NC}\n"
    for mode in jarvis idroid; do
        echo -e "${BLUE}━━━ $mode ━━━${NC}"
        if [[ -d "$SOUND_BASE/$mode" ]]; then
            find "$SOUND_BASE/$mode" -maxdepth 1 -type f -name "*.mp3" | sort | while read -r s; do
                echo -e "  ${GREEN}•${NC} $(basename "$s" .mp3)"
            done
        fi
        echo ""
    done
}

show_status() {
    local current_mode; current_mode=$(get_current_mode)
    local auto_mode;    auto_mode=$(auto_detect_mode)
    local workspace;    workspace=$(get_current_workspace)
    local gaming_active="No"
    [[ -f "$GAMING_FLAG" ]] && gaming_active="${GREEN}Yes (iDroid active)${NC}"

    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}  J.A.R.V.I.S. Sound System  ${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}Saved Mode:${NC}     $current_mode"
    echo -e "${YELLOW}Auto-Detect:${NC}    $auto_mode"
    echo -e "${YELLOW}Workspace:${NC}      $workspace"
    echo -e "${YELLOW}Gaming Mode:${NC}    $(echo -e "$gaming_active")"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ════════════════════════════════════════════════════════════════════
#  🎯 MAIN DISPATCHER
# ════════════════════════════════════════════════════════════════════
case "${1:-status}" in
mute)               audio_mute_toggle ;;
volume-up)          audio_volume_up ;;
volume-down)        audio_volume_down ;;
mic-mute)           mic_mute_toggle ;;
startup)            system_startup ;;
shutdown)           system_shutdown ;;
notification)       notification ;;
screenshot)         screenshot_taken ;;
config-reload)      config_reload ;;
locking-screen)     locking_screen ;;
steam-launch)       steam_launch ;;
photo-export)       photo_export ;;
photo-mode)         photo_mode ;;
gaming-voice)       gaming_mode_voice ;;
streaming)          streaming_on ;;
greeting)           greeting ;;
confirm)            confirm ;;
# Window actions
window-close)       window_close ;;
window-float)       window_float ;;
window-fullscreen)  window_fullscreen ;;
window-tile)        window_tile ;;
window-center)      window_center ;;
# Workspace actions
workspace)          workspace_switch "${2:-Browser}" ;;
workspace-next)     workspace_next ;;
workspace-previous) workspace_previous ;;
# Gaming mode
gamemode-on)        gamemode_on ;;
gamemode-off)       gamemode_off ;;
gaming-toggle)      [[ -f "$GAMING_FLAG" ]] && gamemode_off || gamemode_on ;;
mode)               set_mode "${2:-jarvis}" ;;
auto-mode)          set_mode "$(auto_detect_mode)" ;;
play)               play_sound "${2:-greeting}" "${3:-}" ;;
# App & Media launchers
launch-browser)     launch_browser ;;
launch-firefox)     launch_firefox ;;
launch-discord)     launch_discord ;;
launch-editor)      launch_editor ;;
launch-gimp)        launch_gimp ;;
launch-obs)         launch_obs ;;
launch-spotify)     launch_spotify ;;
open-terminal)      open_terminal ;;
open-files)         open_files ;;
music-play)         music_play ;;
music-pause)        music_pause ;;
music-next)         music_next ;;
music-previous)     music_previous ;;
# Utilities
status)             show_status ;;
list)               list_sounds ;;
*)
echo -e "${RED}✗${NC} Unknown command: $1"
exit 1
;;
esac
